<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calendar_event_cancel_form" model="ir.ui.view">
        <field name="name">calendar.event.cancel.form</field>
        <field name="model">calendar.event.cancel</field>
        <field name="arch" type="xml">
            <form string="Cancel Meeting">
                <group>
                    <field name="event_id" invisible="1"/>
                    <field name="reason" placeholder="Why is the meeting cancelled?"/>
                </group>
                <footer>
                    <button string="Cancel Meeting" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
